MONGODB_URI=mongodb://127.0.0.1:27017/blackjack
MONGODB_DB=blackjack
PORT=5000

# Auth: use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Base URL of the frontend; email links point to /verify-email and /reset-password here.
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API (SwaggerHub demo).
CORS_ORIGINS=https://app.swaggerhub.com,https://editor.swagger.io

# SMTP for verification and password reset emails.
# DigitalOcean blocks ports 25, 465 and 587, so production uses Mailgun's SMTP on 2525.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Deployment scripts require this to be exported in their shell.
SERVER_IP=
